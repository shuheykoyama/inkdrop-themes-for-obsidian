#!/usr/bin/env nu
# Q23-5 on native captures (research/14 §3.4, §6.15): for each measurement JSON written by
# tests/visual/capture-obsidian.sh with CAPTURE_LINES=on and CAPTURE_CURSOR, build a region config from the
# rectangles the setup measured (setup.q23) and run tests/visual/sample-regions.py on the capture.
#
#   gutter : the active line's line-number element, left of the number (2 pt from the edge, 3 pt from the text)
#   gap    : between the gutter and the text (3 pt from the gutter, which holds Kanagawa Dragon's 1 px border,
#            and from the line)
#   line   : the active line right of its text (4 pt from the text and from the line's end)
# All regions keep 3 pt from the line's top and bottom. A region whose per-channel standard deviation is above
# 1.0 is not flat and fails (sample-regions.py, max_sd).
#   Q23-5b continuity: gutter|gap and gap|line within dE2000 1.0.
#   Q23-5a colour: each region within dE2000 1.0 of the editor surface with the active-line colour over it,
#   only where that is known (an opaque surface; the translucent surface depends on the window material).
#
# usage: nu tests/visual/q23-check.nu <out_dir> <measurement.json> ...
# Exit status 1 if any capture fails. Requires Python 3 (sample-regions.py, standard library only).

def region [left: number, top: number, right: number, bottom: number] {
  [$left $top ($right - $left) ($bottom - $top)]
}

def main [out_dir: string, ...measurements: string] {
  let root = ($env.FILE_PWD | path dirname | path dirname)
  mkdir $out_dir
  let results = ($measurements | each {|m|
    let meas = (open $m)
    let q = $meas.setup.q23
    let png = ($m | path dirname | path dirname | path join $meas.capture.file)
    let name = ($png | path basename | str replace ".png" "")
    if $q == null {
      { capture: $name, ok: false, output: "no q23 rectangles in the measurement (CAPTURE_CURSOR not set?)" }
    } else {
      let top = $q.line.top + 3
      let bottom = $q.line.bottom - 3
      let regions = {
        gutter: (region ($q.gutterActive.left + 2) $top ($q.gutterText.left - 3) $bottom)
        gap: (region ($q.gutters.right + 3) $top ($q.line.left - 3) $bottom)
        line: (region ($q.lineText.right + 4) $top ($q.line.right - 4) $bottom)
      }
      let base = {
        _comment: $"Q23-5 regions for ($name), generated by tests/visual/q23-check.nu"
        window_width_points: 1200
        max_sd: 1.0
        regions: $regions
        pairs: [{a: "gutter", b: "gap", max_de2000: 1.0}, {a: "gap", b: "line", max_de2000: 1.0}]
      }
      let config = if $q.expected == null { $base } else {
        let e = ($q.expected | each {|v| $v | math round --precision 2 })
        $base | merge {
          theme_from_name: [["" "capture"]]
          references: {capture: {gutter: $e, gap: $e, line: $e}}
          max_de2000_vs_reference: 1.0
        }
      }
      let cfg_path = ($out_dir | path join $"($name).config.json")
      $config | to json | save --force $cfg_path
      let run = (^python3 -I ($root | path join "tests/visual/sample-regions.py") --config $cfg_path --out ($out_dir | path join $"($name).csv") $png | complete)
      { capture: $name, ok: ($run.exit_code == 0), output: ($run.stdout + $run.stderr | str trim) }
    }
  })
  for r in $results { print $"(if $r.ok { 'PASS' } else { 'FAIL' }) ($r.capture)"; print $r.output }
  let failed = ($results | where ok == false | length)
  print $"\n($results | length) capture\(s\), ($failed) failed"
  if $failed > 0 { exit 1 }
}
